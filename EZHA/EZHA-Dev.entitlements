<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Device builds with a free Personal team, which can't sign Sign in with Apple.
     Pass CODE_SIGN_ENTITLEMENTS=EZHA/EZHA-Dev.entitlements to xcodebuild. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.aliaksei.ezha</string>
	</array>
</dict>
</plist>
